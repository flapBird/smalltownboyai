# Copy to .dev.vars for localhost only. Mock endpoints ALSO require a loopback hostname.
APP_ORIGIN=http://127.0.0.1:3000
APP_MODE=mock
GENERATION_ENABLED=false
PAYMENTS_ENABLED=false
WAFFO_ENVIRONMENT=test
# Configure real Google OAuth only when testing real sign-in:
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WAFFO_STORE_ID=STO_3Gn9gFKccKSVnOjhUU1lYW
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRODUCT_LITE=
WAFFO_PRODUCT_STANDARD=
WAFFO_PRODUCT_PRO=
MERCHANT_APPROVED=false
WAVESPEED_API_KEY=
# Set the same key and signing secret on the web and jobs Workers.
SEEAPI_API_KEY=
SEEAPI_DAILY_CHECK_LIMIT=100
# Uploaded templates are private R2 objects; cleared template audio is preserved.
# Only enable IDs after real 14-second two-pet tests, e.g. living-room,red-fence:
VERIFIED_TEMPLATES=
REFERENCE_LICENSE_CONFIRMED=false
# Enable only independently validated resolutions, e.g. 480p,768p:
VERIFIED_RESOLUTIONS=
MEDIA_SIGNING_SECRET=
# Exact approved WaveSpeed output CDN hostnames, comma-separated. No wildcard:
OUTPUT_HOSTS=
# Comma-separated administrator login emails. Both allowlist and role=admin required.
ADMIN_EMAILS=
# Set as a Cloudflare Secret in production, never a NEXT_PUBLIC variable.
ADMIN_PASSWORD=
