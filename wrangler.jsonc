{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smalltownboyai",
	"keep_vars": true,
	"main": "vinext/server/app-router-entry",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smalltownboyai",
			"database_id": "d84be83b-fc8b-48ec-a84b-6640c026dc8f",
			"migrations_dir": "db/migrations",
		},
		{
			"binding": "smalltownboyai",
			"database_name": "smalltownboyai",
			"database_id": "d84be83b-fc8b-48ec-a84b-6640c026dc8f"
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "smalltownboyai-private"
		},
		{
			"bucket_name": "smalltownboyai-private",
			"binding": "smalltownboyai_private"
		},
	],
  // Runtime variables are managed in Cloudflare Settings.
  // Do not add vars here: explicit values override Dashboard settings.

	"observability": {
		"enabled": true
	},
}