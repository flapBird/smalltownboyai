{
  "name": "smalltownboyai-jobs",
  "main": "worker-jobs.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smalltownboyai",
      "database_id": "d84be83b-fc8b-48ec-a84b-6640c026dc8f",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "smalltownboyai-private" },
  ],
  "keep_vars": true,
  // Runtime variables are managed in Cloudflare Settings.
  // Do not add vars here: explicit values override Dashboard settings.

  "observability": { "enabled": true },
}
